.DS_Store
*.xcuserdatad/

# Xcode projects are generated by xcodegen from project.yml — never committed.
*.xcodeproj/

# Build output, wherever it lands. `.build/` is SwiftPM's, from building the
# protos package directly with `swift build`.
build/
.build/

# Real credentials. .env.development is committed and holds dev-only values;
# anything secret goes here, merged on top of it.
.env.local

# Per-machine xcconfig overrides — where a developer points the Debug build at
# their own laptop or a deployed backend. Debug.xcconfig #include?s it, so its
# absence is fine. See apps/ios/Configurations/Debug.example.xcconfig.
*.local.xcconfig

# Generated by xcodegen from project.yml, alongside the .xcodeproj above. Both
# are pure functions of project.yml plus the xcconfigs, so `make ios-generate`
# is what produces them.
apps/ios/OpenMarket.Info.plist
apps/ios/OpenMarket.entitlements
