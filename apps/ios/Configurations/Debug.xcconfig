// Debug — the build you run from Xcode, pointed at a laptop.
//
// Everything that differs between environments lives in these files rather than
// in `#if DEBUG` branches or in the Xcode UI. Two reasons:
//
//   * `#if DEBUG` is a *compiler* flag, not a build configuration. It cannot
//     express a third environment, and it makes the endpoint invisible to
//     anything that isn't compiling — including the Info.plist, which is what
//     a TestFlight build actually reads.
//   * The .xcodeproj is generated by xcodegen and gitignored, so anything typed
//     into Xcode's own panes survives exactly until the next `make
//     ios-generate`. That has already cost this project a bundle identifier
//     once — see the signing comments in project.yml.

APP_BUNDLE_IDENTIFIER = lol.frens.openmarket.dev
PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_IDENTIFIER)

// The two builds install side by side, so this is the label that tells them
// apart on the home screen, in the app switcher, and in Settings.
DISPLAY_NAME = Openmarket Dev

// Throwaway. Only Release tracks a build number that means anything.
MARKETING_VERSION = 0.0.1
CURRENT_PROJECT_VERSION = 1

// The API, split into scheme and host because **xcconfig treats `//` as a
// comment**: `API_BASE_URL = https://example.com` silently becomes
// `https:`. Splitting is the readable way around that; the alternative is the
// `https:$()//example.com` escape, which looks like a typo forever after.
//
// localhost from the Simulator is the Mac running it, which is what makes
// `make dev` enough to develop against. ATS exempts loopback, so plain HTTP is
// fine there. A physical device needs a host it can reach *over https* — this
// app ships no ATS exception, on purpose. See Debug.example.xcconfig.
API_SCHEME = http
API_HOSTNAME = localhost:8080

// Substituted into OpenMarket.entitlements via $(APNS_ENVIRONMENT). Must be
// `development` for anything signed with a development profile.
APNS_ENVIRONMENT = development

// Optional per-machine overrides, gitignored. Missing is fine — the values
// above stand. Copy Debug.example.xcconfig to get started.
#include? "Debug.local.xcconfig"
