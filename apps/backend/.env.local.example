# cp .env.local.example .env.local
#
# Gitignored, merged on top of .env.development. The server will not boot
# without a Prelude key — nothing is defaulted in quietly, because development is
# meant to run the same code production does.
#
# There is no offline mode and no local substitute: dev talks to the real Prelude
# API, so a code sent here is a real text message and costs real money. The
# numbers on DEV_BYPASS_PHONE_NUMBERS (see .env.development) are what skip it, and
# that skip happens in-process — nothing to run, nothing to point at.

PRELUDE_API_KEY=

# --- Price Check's model calls ------------------------------------------------
# Unlike Prelude, this one has a local stand-in: .env.development sets
# LLM_PROVIDER=stub, which answers in-process with no key, no network and no
# bill. Leave these commented out and the whole feature still works end to end —
# you just get canned answers, and llm_runs rows with NULL token counts.
#
# Uncomment ONE of the two below to talk to a real provider. The key and the
# model are required together; the server refuses to boot with a provider set
# and either missing, and refuses to boot with the stub under ENV=production.
#
# Vercel AI Gateway — one key, any model, and spend across all of them on one
# invoice to reconcile llm_runs against. Model ids carry a vendor prefix, and
# an unprefixed one is refused at boot rather than 404-ing on the first call.
# LLM_PROVIDER=vercel
# LLM_API_KEY=
# LLM_MODEL=google/gemini-3.6-flash
#
# Google directly — one fewer hop, and a free tier to try the feature on.
# LLM_PROVIDER=google
# LLM_API_KEY=
# LLM_MODEL=gemini-3.6-flash

# --- Production ---------------------------------------------------------------
# What the Railway service needs. Both keys are `openssl rand -hex 32` and must
# differ. DATABASE_URL comes from the Postgres plugin. Do not set
# DEV_BYPASS_PHONE_NUMBERS there — it is a boot panic with ENV=production.
# ENV=production
# DATABASE_URL=
# JWT_SECRET=
# REFRESH_TOKEN_HMAC_KEY=

# --- Optional -----------------------------------------------------------------
# ALLOWED_COUNTRY_CODES=1,44,353,61,64   # no "allow all" value; empty fails at boot
# VERIFICATION_MAX_SENDS=500     # global hourly ceiling on the Prelude bill
# VERIFICATION_CODE_LENGTH=6     # must match your Prelude configuration
# APNS_BUNDLE_ID=lol.frens.openmarket
# LLM_MAX_CALLS_PER_USER=60      # per user, per window; calls, not money
# LLM_CALL_WINDOW=1h
# LLM_MAX_ATTEMPTS=2             # attempts per call, including the first
# LLM_TIMEOUT=30s                # deadline for one model call
#
# Observation ingest. The epoch length is chosen by corroboration, not privacy:
# two submissions only count as independent inside one epoch (docs/
# ingest-attribution.md §4.2). The grace is how long a superseded key stays
# readable for investigating a batch noticed late; deleting it is what makes an
# observation permanently unlinkable.
# INGEST_EPOCH_LENGTH=168h       # how long one submitter pseudonym stays stable
# INGEST_EPOCH_KEY_GRACE=336h    # must be at least INGEST_EPOCH_LENGTH
# INGEST_BREAKER_QUARANTINE_RATE=0.4  # refuse a surface above this refusal rate
# INGEST_BREAKER_MIN_CARDS=200   # cards before the rate is believed
# INGEST_BREAKER_WINDOW=6h
# INGEST_SHAPE_WINDOW=168h       # before a payload shape is called unseen
# INGEST_MAX_OBSERVATION_AGE=48h # how late a queued batch may arrive
# INGEST_MAX_CLOCK_SKEW=5m
# INGEST_RAW_RETENTION=168h       # raw batches, accepted payloads, and quarantine
# INGEST_ACTIVITY_RETENTION_DAYS=30
#
# Refusing a client build by name. The circuit breaker needs traffic before it
# reacts and acts on a whole surface; these act at the door on exactly the
# release that is wrong, and nothing from a refused build is stored. Both
# default to off. The build is CURRENT_PROJECT_VERSION, which is monotonic —
# and with a floor set, a client that sends no build is refused, because it
# cannot show it is above one.
# INGEST_MIN_APP_BUILD=0         # 0 disables the floor
# INGEST_BLOCKED_APP_BUILDS=     # comma-separated, for a bad build above the floor
