# Local development defaults. Committed on purpose: there is nothing secret
# here.
#
# The Prelude key goes in .env.local, which is gitignored and merged on top of
# this file — the server will not boot without it. See .env.local.example.

ENV=development
PORT=8080
LOG_LEVEL=debug

# Consumed both by the compose Postgres container (as POSTGRES_*) and by the
# server (as DATABASE_URL), so they cannot drift apart.
POSTGRES_USER=openmarket
POSTGRES_PASSWORD=openmarket
POSTGRES_DB=openmarket_db
DATABASE_URL=postgres://openmarket:openmarket@localhost:5432/openmarket_db?sslmode=disable

# Dev-only signing keys. Distinct values, because config refuses to boot if the
# access-token secret and the refresh-token HMAC key are the same.
JWT_SECRET=dev-jwt-secret-not-for-production
REFRESH_TOKEN_HMAC_KEY=dev-refresh-hmac-key-not-for-production

# Prelude credentials are deliberately absent from this file — they live in
# .env.local, and the server refuses to boot without them.

# Numbers that skip Prelude entirely — what the dev skip button uses, handled
# in-process by verify.BypassSender. This is the whole local-development story:
# there is no stand-in service, so anything NOT on this list sends a real text
# message and is billed. +1 500 555 xxxx is a reserved test range, so it can
# never reach a real person.
DEV_BYPASS_PHONE_NUMBERS=+15005550100
DEV_VERIFICATION_CODE=123456

ALLOWED_COUNTRY_CODES=1

# Cooldown off locally so resend is testable without waiting a minute. It is
# only a hint the client counts down from, never an enforced limit — so with a
# non-bypassed number, holding down Resend sends real texts. The global
# VERIFICATION_MAX_SENDS ceiling is what actually stops that.
VERIFICATION_RESEND_COOLDOWN=0s
