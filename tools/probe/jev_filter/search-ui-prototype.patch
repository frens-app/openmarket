+        let cards = (0..<25).map { card("\($0)") }
+        await filter.evaluate(cards)
+        await filter.evaluate(cards + [cards[0]])
+        XCTAssertEqual(service.calls.map { $0.candidates.count }, [20, 5])
+        var changed = cards[0]
+        changed.title = "White desk"
