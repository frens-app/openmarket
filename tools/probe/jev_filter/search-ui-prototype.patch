+            XCTAssertEqual(filter.visible(cards), cards)
+            XCTAssertNotNil(filter.notice)
+            await filter.evaluate(cards)
+            XCTAssertEqual(service.calls.count, 1, "Failed cards must not cause a retry loop")
+        }
+    }
+
+    func testOldQueryAndDisabledRequestsCannotHideNewResults() async {
+        for disable in [false, true] {
+            let service = SearchFilterTestClient()
+            service.verdicts = ["a": .mismatch]
+            service.suspendNext = true
+            let filter = SearchResultFilter(service: service)
+            filter.begin(query: query())
+            filter.setEnabled(true)
+            let cards = [card("a")]
+            let task = Task { await filter.evaluate(cards) }
+            await service.waitUntilSuspended()
+            if disable { filter.setEnabled(false) }
+            else { filter.begin(query: query("white desk")) }
+            service.resume()
+            await task.value
+            XCTAssertEqual(filter.visible(cards), cards)
+            XCTAssertFalse(filter.isFiltering)
+            if !disable {
+                service.verdicts = ["a": .match]
+                await filter.evaluate(cards)
+                XCTAssertEqual(service.calls.last?.query, "white desk")
+                XCTAssertEqual(filter.visible(cards), cards)
+            }
+        }
+    }
+
+    func testOverlappingEvaluationsShareThePendingBatch() async {
+        let service = SearchFilterTestClient()
+        service.suspendNext = true
+        service.verdicts = ["a": .mismatch]
+        let filter = SearchResultFilter(service: service)
+        filter.begin(query: query())
+        filter.setEnabled(true)
+        let cards = [card("a")]
+        let first = Task { await filter.evaluate(cards) }
+        await service.waitUntilSuspended()
+        let second = Task { await filter.evaluate(cards) }
+        await Task.yield()
+        service.resume()
+        await first.value
+        await second.value
+        XCTAssertEqual(service.calls.count, 1)
+        XCTAssertTrue(filter.visible(cards).isEmpty)
+        XCTAssertFalse(filter.isFiltering)
+    }
+
+    private func query(_ text: String = "black standing desk") -> SearchQuery {
+        SearchQuery(kind: .search(text), radiusKM: 8, citySlug: "sanfrancisco")
+    }
+    private func card(_ id: String) -> Listing {
+        Listing(id: id, title: "Desk", thumbnailURL: URL(string: "https://scontent.fbcdn.net/\(id).jpg"), cardIndex: 0, capturedAt: Date())
+    }
+}
+
+@MainActor
+final class SearchFilterTestClient: SearchFiltering {
+    struct Call { let query: String; let candidates: [SearchFilterCandidate] }
+    var calls: [Call] = []
+    var verdicts: [String: SearchFilterVerdict] = [:]
+    var fails = false
+    var suspendNext = false
+    var transform: (([SearchFilterDecision]) -> [SearchFilterDecision])?
+    private var pending: CheckedContinuation<Void, Never>?
+    private var waiter: CheckedContinuation<Void, Never>?
+
+    func filter(query: String, candidates: [SearchFilterCandidate]) async throws -> [SearchFilterDecision] {
+        calls.append(Call(query: query, candidates: candidates))
+        if suspendNext {
+            suspendNext = false
+            await withCheckedContinuation {
+                pending = $0
+                waiter?.resume()
+                waiter = nil
+            }
+        }
+        if fails { throw APIError.network }
+        let decisions = candidates.map { candidate in
+            var d = SearchFilterDecision()
+            d.id = candidate.id
+            d.verdict = verdicts[d.id] ?? .match
+            d.imageUsed = true
+            return d
+        }
+        return transform?(decisions) ?? decisions
+    }
+    func waitUntilSuspended() async {
+        if pending != nil { return }
+        await withCheckedContinuation { waiter = $0 }
+    }
+    func resume() { pending?.resume(); pending = nil }
+}
