+    func testFailuresAndMissingEvidenceKeepListings() async {
+        for mode in 0..<5 {
+            let service = SearchFilterTestClient()
+            service.verdicts = ["a": .mismatch]
+            service.fails = mode == 0
+            service.transform = { decisions in
+                switch mode {
+                case 1: return []
+                case 2: return [decisions[0], decisions[0]]
+                case 3, 4:
+                    var result = decisions[0]
+                    if mode == 4 { result.verdict = .unknown }
+                    result.imageUsed = false
+                    return [result]
+                default: return decisions
