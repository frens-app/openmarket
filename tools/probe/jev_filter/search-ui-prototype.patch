--- /dev/null
+++ b/apps/ios/Sources/Account/SearchFilterService.swift
@@ -0,0 +1,27 @@
+import Connect
+import Foundation
+import OpenMarketProtos
+
+@MainActor
+protocol SearchFiltering {
+    func filter(query: String, candidates: [SearchFilterCandidate]) async throws -> [SearchFilterDecision]
+}
+
+@MainActor
+final class SearchFilterService: SearchFiltering {
+    private let session: AccountSession
+    private lazy var client = SearchServiceClient(client: API.makeProtocolClient(timeout: 7))
+
+    init(session: AccountSession = .shared) { self.session = session }
+
+    func filter(query: String, candidates: [SearchFilterCandidate]) async throws -> [SearchFilterDecision] {
+        var request = FilterListingsRequest()
+        request.query = query
+        request.candidates = candidates
+        let response = await client.filterListings(request: request, headers: try await session.authorizedHeaders())
+        guard let message = response.message else {
+            throw response.error.map { ($0 as? ConnectError)?.asAPIError ?? APIError.network } ?? APIError.network
+        }
+        return message.decisions
+    }
+}
diff --git a/apps/ios/Sources/Store/SearchResultFilter.swift b/apps/ios/Sources/Store/SearchResultFilter.swift
new file mode 100644
index 0000000..4e50ccd
--- /dev/null
+++ b/apps/ios/Sources/Store/SearchResultFilter.swift
@@ -0,0 +1,144 @@
+import Combine
+import Foundation
+import OpenMarketProtos
+
+@MainActor
+final class SearchResultFilter: ObservableObject {
+    @Published private(set) var isEnabled = false
+    @Published private(set) var isFiltering = false
+    @Published private(set) var notice: String?
+    @Published private var decisions: [Card: SearchFilterDecision] = [:]
+    @Published var showHidden = false
+
+    private struct Card: Hashable {
+        let id: String
+        let title: String
+        let imageURL: String
+        init(_ listing: Listing) {
+            id = listing.id
+            title = String((listing.title ?? "").prefix(500))
+            imageURL = listing.thumbnailURL?.absoluteString ?? ""
+        }
+        var candidate: SearchFilterCandidate {
+            var candidate = SearchFilterCandidate()
+            candidate.id = id
+            candidate.title = title
+            candidate.headlineImageURL = imageURL.count <= 2048 ? imageURL : ""
+            return candidate
+        }
+    }
+    private struct Job {
+        let id = UUID()
+        let cards: [Card]
+        let task: Task<Result<[SearchFilterDecision], Error>, Never>
+    }
+    private let service: any SearchFiltering
+    private var query: String?
+    private(set) var revision = 0
+    private var job: Job?
+
+    init(service: any SearchFiltering) { self.service = service }
+
+    func begin(query: SearchQuery?) {
+        reset()
+        if case .search(let text) = query?.kind {
+            self.query = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        } else {
+            self.query = nil
+        }
+    }
+
+    func setEnabled(_ enabled: Bool) {
+        guard enabled != isEnabled else { return }
+        reset()
+        isEnabled = enabled
+    }
+
+    private func reset() {
+        revision += 1
+        job?.task.cancel()
+        job = nil
+        decisions = [:]
+        isFiltering = false
+        notice = nil
+        showHidden = false
+    }
+
+    func isHidden(_ listing: Listing) -> Bool {
+        isEnabled && decisions[Card(listing)]?.verdict == .mismatch
+    }
+
+    func visible(_ listings: [Listing]) -> [Listing] {
+        guard isEnabled, !showHidden else { return listings }
+        return listings.filter { !isHidden($0) }
+    }
+
+    func evaluate(_ listings: [Listing]) async {
+        guard isEnabled, let query, !query.isEmpty else { return }
+        guard query.count <= 300 else {
+            notice = "AI filtering supports searches up to 300 characters. All listings kept."
+            return
+        }
+        let revision = revision
+        // A toggle and a newly arriving page can need the same cards concurrently.
+        while let current = job {
+            let result = await current.task.value
+            guard revision == self.revision, !Task.isCancelled else { return }
+            finish(current, result: result)
+        }
+        guard revision == self.revision, !Task.isCancelled else { return }
+        var seen = Set<String>()
+        let cards = listings.map(Card.init).filter { decisions[$0] == nil && seen.insert($0.id).inserted }
+        guard !cards.isEmpty else { return }
+        let service = service
+        let current = Job(cards: cards, task: Task {
+            do {
+                var all: [SearchFilterDecision] = []
+                for start in stride(from: 0, to: cards.count, by: 20) {
+                    try Task.checkCancellation()
+                    let batch = Array(cards[start..<min(start + 20, cards.count)])
+                    let results = try await service.filter(query: query, candidates: batch.map(\.candidate))
+                    let expected = Set(batch.map(\.id))
+                    guard results.count == batch.count, Set(results.map(\.id)) == expected,
+                          results.allSatisfy({ [.match, .unknown, .mismatch].contains($0.verdict) && ($0.verdict != .mismatch || $0.imageUsed) }) else {
+                        throw APIError.message("Incomplete AI filter response.")
+                    }
+                    all.append(contentsOf: results)
+                }
+                return .success(all)
+            } catch { return .failure(error) }
+        })
+        job = current
+        isFiltering = true
+        let result = await current.task.value
+        guard revision == self.revision else { return }
+        finish(current, result: result)
+    }
+
+    private func finish(_ current: Job, result: Result<[SearchFilterDecision], Error>) {
+        guard job?.id == current.id else { return }
+        job = nil
+        isFiltering = false
+        switch result {
+        case .success(let results):
+            let byID = Dictionary(uniqueKeysWithValues: results.map { ($0.id, $0) })
+            for card in current.cards { decisions[card] = byID[card.id] }
+            if results.contains(where: { !$0.imageUsed }) {
+                notice = "Listings with unreadable photos were kept."
+            }
+        case .failure(let error):
+            // Cache the fail-open result for this search so duplicate cards cannot trigger a retry loop.
+            for card in current.cards {
+                var decision = SearchFilterDecision()
+                decision.id = card.id
+                decision.verdict = .unknown
+                decisions[card] = decision
+            }
+            if case APIError.rateLimited = error {
+                notice = "AI filter limit reached. New listings are being kept."
+            } else {
+                notice = "AI filtering unavailable. Unchecked listings were kept."
+            }
+        }
+    }
+}
